{
  "id": "./",
  "name": "FlipLoop",
  "short_name": "FlipLoop",
  "description": "ציירו דף אחרי דף ותראו את הציור זז.",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#DAD6CC",
  "theme_color": "#DAD6CC",
  "categories": ["education", "entertainment", "kids"],
  "launch_handler": { "client_mode": "focus-existing" },
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "assets/screenshots/narrow-home.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "ציירו כמה דפים ותראו אותם זזים" },
    { "src": "assets/screenshots/narrow-editor.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "עורך האנימציה עם רצועת הפריימים" },
    { "src": "assets/screenshots/wide-editor.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "עורך האנימציה במחשב" },
    { "src": "assets/screenshots/wide-home.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "שולחן האור של FlipLoop" }
  ],
  "shortcuts": [
    { "name": "אנימציה חדשה", "url": "./#/new", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "האתגר של השבוע", "url": "./#/challenge", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
